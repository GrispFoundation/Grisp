# File: grisp_v0.13_example.grisp
# Purpose: authoring example for GRISP v0.13

policy TimeoutRetry3x {
  timeout_ms = 5000
  on_timeout = retry
  retry { backoff = exponential; max_attempts = 3; initial_delay_ms = 100 }
}

policy RateLimit(max_per_tick, max_per_second) {
  max_per_tick = max_per_tick
  max_per_second = max_per_second
}

policy RateLimitHigh {
  max_per_tick = 200
  max_per_second = 1000
}

policy CircuitBreakerDefault {
  threshold = 10
  cooldown_ms = 60000
  half_open_attempts = 2
}

policy RetentionAudit {
  mode = audit
  keep_days = 90
}

pure fn Now(): number
pure fn NewId(): identifier
pure fn Normalize(s: string): string
pure fn DecideToolKind(desc: string): string
pure fn GenerateRequestKey(task: Task, desc: string): string
pure fn CanExecute(agent: Agent, task: Task): boolean
effect(idempotent=true, timeout_ms=5000, on_timeout="return_default")
fn MergeResults(tasks: Task[]): value
pure fn CalculateConfidence(tasks: Task[]): number

node Agent {
  id: identifier
  role: string
  capabilities: array
  capacity_total: number
  capacity_used: number
}

node Goal {
  id: identifier
  description: string
  lifecycle: string
  created_at: number
  updated_at: number?
  tags: array?
}

node Task {
  id: identifier
  description: string
  lifecycle: string
  priority: integer?
  cost: number?
  retries: integer?
  max_retries: integer?
  tags: array?
  created_at: number
  updated_at: number?
}

node ToolRequest {
  id: identifier
  kind: string
  input: object?
  status: string
  created_at: number
  task: Task
  request_key: string?
}

node ToolResult {
  id: identifier
  request: ToolRequest
  success: boolean
  data: object?
  error: string?
  created_at: number
}

node Event {
  id: identifier
  type: string
  timestamp: number
  rule_id: string?
  trace_id: string?
  payload: object?
  match_nodes: array?
  match_edges: array?
  written_nodes: array?
  written_edges: array?
}

edge subgoal_of(Goal -> Goal)
edge belongs_to_goal(Task -> Goal)
edge depends_on(Task -> Task)
edge assigns(Agent -> Task)
edge created_by_plan(Goal -> ToolRequest)
edge tool_for_task(ToolRequest -> Task)
edge result_of_request(ToolResult -> ToolRequest)
edge event_for(Event -> Task)

rule MergeDuplicatePlannedTasks priority=95 {
  metadata { idempotent = true; use RetentionAudit; emits = ["MERGE_TASKS"] }
  when {
    TaskA where lifecycle == "planned"
    let NormA = Normalize(TaskA.description)
    TaskB where lifecycle == "planned" and TaskB.id != TaskA.id and Normalize(TaskB.description) == NormA
    condition SamePlanOrigin(TaskA, TaskB)
  }
  then {
    let Keep = (TaskA.created_at <= TaskB.created_at ? TaskA : TaskB)
    let Drop = (Keep == TaskA ? TaskB : TaskA)
    update Keep { tags = Keep.tags + Drop.tags }
    delete Drop
    emit Event(type="MERGE_TASKS", payload={kept:Keep.id, dropped:Drop.id})
  }
}

rule ActivatePlannedTask priority=90 {
  metadata { idempotent = true; depends_on = ["MergeDuplicatePlannedTasks"]; emits = ["ACTIVATE_TASK"] }
  when {
    Task where lifecycle == "planned"
    condition not exists edge depends_on(Task -> Dep) where Dep.lifecycle in ["pending","assigned","in_progress","waiting_tool"]
  }
  then {
    update Task { lifecycle = "pending", updated_at = Now() }
    emit Event(type="ACTIVATE_TASK", payload={task:Task.id})
  }
}

rule AssignPendingTask priority=80 {
  metadata {
    idempotent = false
    depends_on = ["ActivatePlannedTask"]
    use TimeoutRetry3x
    use RateLimit(max_per_tick=200, max_per_second=1000)
    use CircuitBreakerDefault
    emits = ["ASSIGN_TASK"]
  }
  when {
    Task where lifecycle == "pending" and cost = Cost
    Specialist where role == "Specialist" and capacity_total - capacity_used >= Cost
    condition CanExecute(Specialist, Task)
  }
  then {
    let NewCapacity = Specialist.capacity_used + Cost
    update Task { lifecycle = "assigned", updated_at = Now() }
    update Specialist { capacity_used = NewCapacity }
    create assigns(Specialist -> Task)
    emit Event(type="ASSIGN_TASK", payload={task:Task.id, agent:Specialist.id})
  }
  hooks { after_commit: ["emit_assignment_webhook"] }
}

rule StartAssignedTask priority=70 {
  metadata { idempotent = true; depends_on = ["AssignPendingTask"]; emits = ["START_TASK"] }
  when {
    Task where lifecycle == "assigned"
    exists edge assigns(Agent -> Task)
  }
  then {
    update Task { lifecycle = "in_progress", updated_at = Now() }
    emit Event(type="START_TASK", payload={task:Task.id})
  }
}

rule CreateToolRequest priority=60 {
  metadata {
    idempotent = false
    depends_on = ["StartAssignedTask"]
    use RateLimit(max_per_tick=200, max_per_second=1000)
    use CircuitBreakerDefault
    emits = ["CREATE_TOOL_REQUEST"]
  }
  when {
    Task where lifecycle == "in_progress" and description = Desc
    exists edge assigns(Agent -> Task)
    condition not exists TR where TR.task == Task and TR.status in ["pending","running"]
  }
  then {
    let RK = GenerateRequestKey(Task, Desc)
    update Task { lifecycle = "waiting_tool", updated_at = Now() }
    create TR: ToolRequest {
      id = NewId()
      kind = DecideToolKind(Desc)
      input = Desc
      status = "pending"
      created_at = Now()
      task = Task
      request_key = RK
    }
    create tool_for_task(TR -> Task)
    emit Event(type="CREATE_TOOL_REQUEST", payload={task:Task.id, request:TR.id})
  }
  hooks { after_commit: ["schedule_tool_request_timeout", "emit_tool_request_webhook"] }
}

rule IntegrateToolResultSuccess priority=95 {
  metadata { idempotent = true; depends_on = ["CreateToolRequest"]; emits = ["TOOL_RESULT_SUCCESS"] }
  when {
    ToolRes where success == true and request = TR
    TR where status == "completed" and TR.task = Task
    Task where lifecycle == "waiting_tool"
    exists edge tool_for_task(TR -> Task)
  }
  then {
    update Task { lifecycle = "completed", result = ToolRes.data, updated_at = Now() }
    delete assigns(Agent -> Task)
    create result_of_request(ToolRes -> TR)
    emit Event(type="TOOL_RESULT_SUCCESS", payload={task:Task.id, request:TR.id})
  }
}

rule IntegrateToolResultFailure priority=90 {
  metadata { idempotent = true; depends_on = ["CreateToolRequest"]; emits = ["TOOL_RESULT_FAILURE"] }
  when {
    ToolRes where success == false and request = TR
    TR where status == "failed" and TR.task = Task
    Task where lifecycle == "waiting_tool" and retries = R and max_retries = MaxR
    exists edge tool_for_task(TR -> Task)
  }
  then {
    let NewRetries = R + 1
    let WillFail = NewRetries > MaxR
    update Task { lifecycle = (WillFail ? "failed" : "planned"), retries = NewRetries, updated_at = Now(), error = ToolRes.error }
    delete assigns(Agent -> Task) when WillFail == true
    create result_of_request(ToolRes -> TR)
    emit Event(type="TOOL_RESULT_FAILURE", payload={task:Task.id, request:TR.id, will_fail:WillFail})
  }
}

rule ReleaseCapacityOnCompletion priority=85 {
  metadata { idempotent = true; depends_on = ["IntegrateToolResultSuccess", "IntegrateToolResultFailure"]; emits = ["RELEASE_CAPACITY"] }
  when {
    Task where lifecycle in ["completed","failed"] and cost = Cost
    exists edge assigns(Agent -> Task)
  }
  then {
    update Agent { capacity_used = Agent.capacity_used - Cost }
    delete assigns(Agent -> Task)
    emit Event(type="RELEASE_CAPACITY", payload={task:Task.id, agent:Agent.id})
  }
}

rule SynthesizeLeafGoalResults priority=50 {
  metadata { idempotent = true; depends_on = ["IntegrateToolResultSuccess", "ReleaseCapacityOnCompletion"]; emits = ["SYNTHESIZE_GOAL"] }
  when {
    Goal where lifecycle in ["pending","in_progress"]
    condition IsLeafGoal(Goal)
    CompletedTasks many Task where lifecycle == "completed" and belongs_to_goal(CompletedTasks -> Goal)
    let TaskCount = count(CompletedTasks)
    condition TaskCount > 0
  }
  then {
    let Result = MergeResults(CompletedTasks)
    update Goal { lifecycle = "completed", updated_at = Now() }
    create Answer: FinalAnswer { id = NewId(), goal = Goal, content = Result, confidence = CalculateConfidence(CompletedTasks), source_tasks = CompletedTasks }
    emit Event(type="SYNTHESIZE_GOAL", payload={goal:Goal.id, answer:Answer.id, task_count:TaskCount})
  }
  hooks { after_commit: ["archive_goal_results"] }
}
