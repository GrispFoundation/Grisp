# =========================================================
# GRISP - Multi-Agent Collaboration Protocol (Version 0.01)
# Designed for AI-to-AI and AI-to-Tool interaction
# =========================================================

namespace AgentCollaboration {

    # ======================
    # Shared Data Structure
    # ======================
    node Task {
        id: string
        description: string
        status: ("pending" | "in_progress" | "completed" | "failed")
        priority: number
        assigned_to: identifier
        result: value?
    }

    # ======================
    # Core Communication Rules
    # ======================

    # Rule 1: Planner sends task to Specialist
    node rule.DelegateTask {
        match: graph = {
            Planner: node = { type = "Planner" }
            Task: node = {
                status = "pending"
                assigned_to = null
            }
        }

        rewrite: graph = {
            Planner: node = { type = "Planner" }
            Specialist: node = { type = "Specialist" }
            Task: node = {
                status = "in_progress"
                assigned_to = Specialist
            }
            Message: node = {
                type = "TaskAssigned"
                content = Task
                from = Planner
                to = Specialist
            }
        }
    }

    # Rule 2: Specialist processes task and returns result
    node rule.ProcessAndReturn {
        match: graph = {
            Specialist: node = { type = "Specialist" }
            Task: node = {
                status = "in_progress"
                assigned_to = Specialist
                description = Desc
            }
        }

        rewrite: graph = {
            Specialist: node = { type = "Specialist" }
            Task: node = {
                status = "completed"
                result = ExecuteTool(Desc)          # Calls external tool
            }
            Message: node = {
                type = "TaskCompleted"
                content = Task
                from = Specialist
                to = "Planner"
            }
        }
    }

    # Rule 3: Planner aggregates multiple results (AI-to-AI synthesis)
    node rule.SynthesizeResults {
        match: graph = {
            Planner: node = { type = "Planner" }
            Tasks: many node = {
                status = "completed"
                result = Result
            }
        }

        rewrite: graph = {
            Planner: node = { type = "Planner" }
            FinalReport: node = {
                type = "FinalAnswer"
                content = MergeResults(Tasks)
                confidence = CalculateConfidence(Tasks)
            }
        }
    }

    # ======================
    # Tool Integration Layer (AI -> External Tool)
    # ======================

    node tool.WebSearch {
        input: string
        output: {
            success: boolean
            data: json?
            error: string?
        }
    }

    node tool.CodeExecution {
        language: ("delphi" | "python" | "pascal")
        code: string
        output: string
    }

    # Example of AI generating safe tool call via GRISP
    node rule.SafeCodeExecution {
        match: graph = {
            AI: node = { type = "CoderAI" }
            Request: node = {
                type = "ExecuteCode"
                code = Code
            }
        }

        rewrite: graph = {
            AI: node = { type = "CoderAI" }
            Result: node = tool.CodeExecution {
                language = "delphi"
                code = Code
            }
        }
    }
}