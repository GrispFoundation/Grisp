# ===============================================================
# GRISP - Agent Collaboration Protocol Version 0.06
# Planner returns graph-native plan nodes instead of opaque blobs
# ===============================================================

namespace AgentCollaborationV006 {

  # Core nodes
  node Agent {
    id: identifier
    role: ("Planner" | "Specialist")
    capabilities: array<identifier>
    capacity: number
  }

  node Goal {
    id: identifier
    description: string
    status: ("pending" | "in_progress" | "completed" | "failed")
    phase: ("planned" | "active")
    created_at: number
    updated_at: number
    tags: array<identifier>
    failure_policy: ("fail_fast" | "best_effort" | "majority")
  }

  node Task {
    id: identifier
    description: string
    status: ("pending" | "assigned" | "in_progress" | "waiting_tool" | "completed" | "failed")
    phase: ("planned" | "active")
    priority: number
    cost: number
    retries: number
    max_retries: number
    tags: array<identifier>
    created_at: number
    updated_at: number
  }

  # Plan graph nodes (planner injects these)
  node PlannedGoal {
    id: identifier
    description: string
    tags: array<identifier>
  }

  node PlannedTask {
    id: identifier
    description: string
    tags: array<identifier>
    cost: number
  }

  # Plan edges
  edge planned_subgoal_of { from: PlannedGoal to: PlannedGoal }
  edge planned_task_of { from: PlannedTask to: PlannedGoal }
  edge planned_depends_on { from: PlannedTask to: PlannedTask }

  # Runtime request nodes
  node PlanningRequest {
    id: identifier
    goal: node<Goal>
    status: ("pending" | "running" | "completed" | "failed")
    created_at: number
    hint: value?
  }

  node PlanningResult {
    id: identifier
    request: node<PlanningRequest>
    success: boolean
    error: string?
    # plan is represented by PlannedGoal/PlannedTask nodes and planned_* edges
  }

  node ToolRequest { ... }   # same shape as earlier versions
  node ToolResult { ... }

  # Provenance
  edge planning_for_goal { from: PlanningRequest to: Goal }
  edge result_of_planning { from: PlanningResult to: PlanningRequest }

  # Key rules (high level)
  # - CreatePlanningRequest: planner request created for complex goals
  # - MarkPlanningRunning: runtime marks planning requests running
  # - ApplyPlanningResultSuccess: planner runtime injects PlannedGoal/PlannedTask nodes and a PlanningResult(success=true)
  # - InstantiatePlan: helper expands Planned* graph into real Goal/Task nodes (instantiation helpers used)
  # - Validation rules operate on Planned* graph (cycle detection, dedupe)
  # - Activation rules flip phase from planned -> active (phase + status model)
  # - Execution rules operate on active nodes

  # Helpers (runtime)
  fn InstantiateGoalsFromPlan(...)
  fn InstantiateTasksFromPlan(...)
  fn AllTasksCompleted(...)
  fn AvailableCapacity(...)
}
