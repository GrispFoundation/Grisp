⟦BEGIN PROGRAM⟧
  ⟦BEGIN METADATA⟧
    author = "Developer"
    version = "1.0"
    project = "Go2Delphi Translator"
  ⟦END METADATA⟧

  ⟦BEGIN SEMANTIC MAP⟧
    ⟦BEGIN MAPPING⟧entity = "go source file" : WorldState.go_file⟦END MAPPING⟧
    ⟦BEGIN MAPPING⟧entity = "delphi output file" : WorldState.pas_file⟦END MAPPING⟧
    ⟦BEGIN MAPPING⟧action = "read go file" : FileSystem.read_file⟦END MAPPING⟧
    ⟦BEGIN MAPPING⟧action = "parse go code" : GoParser.parse⟦END MAPPING⟧
    ⟦BEGIN MAPPING⟧action = "generate delphi" : DelphiGenerator.generate⟦END MAPPING⟧
    ⟦BEGIN MAPPING⟧action = "write pascal file" : FileSystem.write_file⟦END MAPPING⟧
    ⟦BEGIN MAPPING⟧constraint = "max file size" : 1048576⟦END MAPPING⟧
  ⟦END SEMANTIC MAP⟧

  ⟦BEGIN GOAL⟧
    translate the go source file to a delphi pascal file
  ⟦END GOAL⟧

  ⟦BEGIN CONSTRAINT⟧
    max file size must not be exceeded
  ⟦END CONSTRAINT⟧

  ⟦BEGIN ASSUMPTION⟧
    the go source file is valid and compiles
  ⟦END ASSUMPTION⟧

  ⟦BEGIN RISK⟧
    translation may not preserve all semantics without manual review
  ⟦END RISK⟧

  ⟦BEGIN POLICY⟧
    always use idiomatic pascal naming conventions
  ⟦END POLICY⟧
⟦END PROGRAM⟧