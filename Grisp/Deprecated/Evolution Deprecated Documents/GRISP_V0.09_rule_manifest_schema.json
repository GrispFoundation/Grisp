{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GRISP Rule Manifest",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "priority": { "type": "integer" },
    "idempotent": { "type": "boolean" },
    "sideEffectFlags": { "type": "array", "items": { "type": "string" } },
    "timeout_ms": { "type": ["integer", "null"] },
    "rate_limit": {
      "type": "object",
      "properties": {
        "max_per_tick": { "type": ["integer", "null"] },
        "max_per_second": { "type": ["integer", "null"] }
      }
    },
    "circuit_breaker": {
      "type": "object",
      "properties": {
        "failure_threshold": { "type": "integer" },
        "cooldown_ms": { "type": "integer" },
        "half_open_attempts": { "type": "integer" }
      }
    },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "after_commit": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["id", "priority", "idempotent"]
}
