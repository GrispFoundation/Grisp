{
  "ir_schema_version": "1.0",
  "type_definitions_hash": "test_social_graph",
  "max_ticks": 10,
  "rules": [
    {
      "rule_id": "init_person_alice",
      "base_priority": 10,
      "priority_scale": 1,
      "fairness_scale": 1,
      "patterns": [],
      "constraints": [],
      "let_bindings": [],
      "actions": [
        {
          "tag": "CreateNode",
          "variable": "p",
          "type_name": "Person",
          "fields": {
            "name": { "tag": "Literal", "value": "Alice" },
            "age": { "tag": "Literal", "value": 30 }
          }
        }
      ]
    },
    {
      "rule_id": "init_person_bob",
      "base_priority": 10,
      "priority_scale": 1,
      "fairness_scale": 1,
      "patterns": [],
      "constraints": [],
      "let_bindings": [],
      "actions": [
        {
          "tag": "CreateNode",
          "variable": "p",
          "type_name": "Person",
          "fields": {
            "name": { "tag": "Literal", "value": "Bob" },
            "age": { "tag": "Literal", "value": 25 }
          }
        }
      ]
    },
    {
      "rule_id": "alice_follows_bob",
      "base_priority": 20,
      "priority_scale": 1,
      "fairness_scale": 1,
      "patterns": [
        {
          "tag": "MatchNode",
          "variable": "alice",
          "type_name": "Person"
        },
        {
          "tag": "MatchNode",
          "variable": "bob",
          "type_name": "Person"
        }
      ],
      "constraints": [
        {
          "tag": "Binary",
          "op": "==",
          "left": { "tag": "Field", "variable": "alice", "field": "name" },
          "right": { "tag": "Literal", "value": "Alice" }
        },
        {
          "tag": "Binary",
          "op": "==",
          "left": { "tag": "Field", "variable": "bob", "field": "name" },
          "right": { "tag": "Literal", "value": "Bob" }
        }
      ],
      "let_bindings": [],
      "actions": [
        {
          "tag": "CreateEdge",
          "variable": "f",
          "type_name": "Follows",
          "src": { "tag": "Var", "name": "alice" },
          "tgt": { "tag": "Var", "name": "bob" },
          "fields": {
            "since": { "tag": "Literal", "value": 2024 }
          }
        },
        {
          "tag": "EmitEvent",
          "event_type": "FollowCreated",
          "payload": [
            { "tag": "Field", "variable": "alice", "field": "name" },
            { "tag": "Field", "variable": "bob", "field": "name" }
          ]
        }
      ]
    },
    {
      "rule_id": "bob_follows_alice",
      "base_priority": 15,
      "priority_scale": 1,
      "fairness_scale": 2,
      "patterns": [
        {
          "tag": "MatchNode",
          "variable": "bob",
          "type_name": "Person"
        },
        {
          "tag": "MatchNode",
          "variable": "alice",
          "type_name": "Person"
        }
      ],
      "constraints": [
        {
          "tag": "Binary",
          "op": "==",
          "left": { "tag": "Field", "variable": "bob", "field": "name" },
          "right": { "tag": "Literal", "value": "Bob" }
        },
        {
          "tag": "Binary",
          "op": "==",
          "left": { "tag": "Field", "variable": "alice", "field": "name" },
          "right": { "tag": "Literal", "value": "Alice" }
        }
      ],
      "let_bindings": [],
      "actions": [
        {
          "tag": "CreateEdge",
          "variable": "f",
          "type_name": "Follows",
          "src": { "tag": "Var", "name": "bob" },
          "tgt": { "tag": "Var", "name": "alice" },
          "fields": {
            "since": { "tag": "Literal", "value": 2023 }
          }
        },
        {
          "tag": "EmitEvent",
          "event_type": "FollowCreated",
          "payload": [
            { "tag": "Field", "variable": "bob", "field": "name" },
            { "tag": "Field", "variable": "alice", "field": "name" }
          ]
        }
      ]
    },
    {
      "rule_id": "update_age_on_follow",
      "base_priority": 5,
      "priority_scale": 1,
      "fairness_scale": 1,
      "patterns": [
        {
          "tag": "MatchNode",
          "variable": "person",
          "type_name": "Person"
        },
        {
          "tag": "MatchNode",
          "variable": "target",
          "type_name": "Person"
        },
        {
          "tag": "MatchEdge",
          "variable": "f",
          "type_name": "Follows",
          "src": "person",
          "tgt": "target"
        }
      ],
      "constraints": [
        {
          "tag": "Binary",
          "op": "<",
          "left": { "tag": "Field", "variable": "target", "field": "age" },
          "right": { "tag": "Literal", "value": 30 }
        }
      ],
      "let_bindings": [
        {
          "variable": "new_age",
          "expr": {
            "tag": "Binary",
            "op": "+",
            "left": { "tag": "Field", "variable": "target", "field": "age" },
            "right": { "tag": "Literal", "value": 1 }
          }
        }
      ],
      "actions": [
        {
          "tag": "UpdateField",
          "target": { "tag": "Var", "name": "target" },
          "field": "age",
          "expr": { "tag": "Var", "name": "new_age" }
        },
        {
          "tag": "EmitEvent",
          "event_type": "AgeIncreased",
          "payload": [
            { "tag": "Field", "variable": "target", "field": "name" },
            { "tag": "Var", "name": "new_age" }
          ]
        }
      ]
    },
    {
      "rule_id": "unfollow_after_three_ticks",
      "base_priority": 30,
      "priority_scale": 1,
      "fairness_scale": 10,
      "patterns": [
        {
          "tag": "MatchNode",
          "variable": "p1",
          "type_name": "Person"
        },
        {
          "tag": "MatchNode",
          "variable": "p2",
          "type_name": "Person"
        },
        {
          "tag": "MatchEdge",
          "variable": "f",
          "type_name": "Follows",
          "src": "p1",
          "tgt": "p2"
        }
      ],
      "constraints": [],
      "let_bindings": [],
      "actions": [
        {
          "tag": "DeleteEdge",
          "expr": { "tag": "Var", "name": "f" }
        },
        {
          "tag": "EmitEvent",
          "event_type": "FollowRemoved",
          "payload": [
            { "tag": "Field", "variable": "p1", "field": "name" },
            { "tag": "Field", "variable": "p2", "field": "name" }
          ]
        }
      ]
    }
  ],
  "initial_state": {
    "tick_number": 0,
    "graph": {
      "nodes": [],
      "edges": []
    },
    "prev_matches": {}
  }
}