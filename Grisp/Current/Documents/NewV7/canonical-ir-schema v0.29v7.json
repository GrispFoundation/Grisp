
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grisp.dev/schemas/canonical-ir-v0.29v7.json",
  "title": "GRISP Canonical IR v0.29v7",
  "type": "object",
  "required": ["ir_version", "manifest_id", "manifest_version", "types", "functions", "rules"],
  "additionalProperties": false,
  "properties": {
    "ir_version": { "type": "string", "const": "grisp-ir-v0.29v7" },
    "manifest_id": { "type": "string" },
    "manifest_version": { "type": "string" },
    "types": { "type": "array", "items": { "$ref": "#/definitions/typeDef" } },
    "functions": { "type": "array", "items": { "$ref": "#/definitions/functionDef" } },
    "rules": { "type": "array", "items": { "$ref": "#/definitions/ruleDef" } },
    "constants": { "$ref": "#/definitions/constants" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "definitions": {
    "typeDef": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "name", "fields"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "node_type" },
            "name": { "$ref": "#/definitions/typeName" },
            "fields": { "$ref": "#/definitions/fieldMap" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "from", "to", "fields"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "edge_type" },
            "name": { "$ref": "#/definitions/typeName" },
            "from": { "$ref": "#/definitions/typeName" },
            "to": { "$ref": "#/definitions/typeName" },
            "fields": { "$ref": "#/definitions/fieldMap" }
          }
        }
      ]
    },
    "typeName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
    "fieldMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/typeExpr" },
      "minProperties": 0
    },
    "typeExpr": {
      "oneOf": [
        { "type": "string", "enum": ["Boolean","Integer","String","Identifier"] },
        {
          "type": "object",
          "oneOf": [
            { "properties": { "FixedPoint": { "type": "integer", "minimum": 0 } }, "required": ["FixedPoint"], "additionalProperties": false },
            { "properties": { "List": { "$ref": "#/definitions/typeExpr" } }, "required": ["List"], "additionalProperties": false },
            { "properties": { "Map": { "type": "array", "minItems": 2, "maxItems": 2, "items": [{ "type": "string", "const": "String" }, { "$ref": "#/definitions/typeExpr" }] } }, "required": ["Map"], "additionalProperties": false }
          ]
        }
      ]
    },
    "functionDef": {
      "type": "object",
      "required": ["function_id", "kind", "parameters", "return_type"],
      "additionalProperties": false,
      "properties": {
        "function_id": { "$ref": "#/definitions/identifier" },
        "kind": { "enum": ["pure", "effect_deterministic"] },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/definitions/identifier" },
              "type": { "$ref": "#/definitions/typeExpr" }
            }
          }
        },
        "return_type": { "$ref": "#/definitions/typeExpr" },
        "declared_reads": { "type": "array", "items": { "$ref": "#/definitions/dependency" } }
      }
    },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "dependency": {
      "type": "object",
      "required": ["dependency"],
      "additionalProperties": false,
      "properties": {
        "dependency": { "enum": ["NodeExistence", "EdgeExistence", "Field", "Predicate", "Extent", "Ordering", "EdgePredicate", "EdgeOrdering", "EdgeType", "Adjacency"] },
        "node": { "$ref": "#/definitions/identifier" },
        "edge": { "$ref": "#/definitions/identifier" },
        "element": { "$ref": "#/definitions/identifier" },
        "type": { "$ref": "#/definitions/typeName" },
        "field": { "$ref": "#/definitions/identifier" },
        "edge_type": { "$ref": "#/definitions/typeName" },
        "direction": { "enum": ["incoming", "outgoing"] }
      }
    },
    "ruleDef": {
      "type": "object",
      "required": ["rule_id", "priority", "pattern", "actions"],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "$ref": "#/definitions/identifier" },
        "priority": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
        "pattern": { "type": "array", "items": { "$ref": "#/definitions/pattern" } },
        "actions": { "type": "array", "items": { "$ref": "#/definitions/action" } }
      }
    },
    "pattern": {
      "oneOf": [
        { "$ref": "#/definitions/patternBinding" },
        { "$ref": "#/definitions/patternEdge" },
        { "$ref": "#/definitions/patternExistence" },
        { "$ref": "#/definitions/patternLet" },
        { "$ref": "#/definitions/patternCollection" },
        { "$ref": "#/definitions/patternCondition" }
      ]
    },
    "patternBinding": {
      "type": "object",
      "required": ["kind", "variable", "type"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Binding" },
        "variable": { "$ref": "#/definitions/identifier" },
        "type": { "$ref": "#/definitions/typeName" }
      }
    },
    "patternEdge": {
      "type": "object",
      "required": ["kind", "edge_type", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Edge" },
        "edge_type": { "$ref": "#/definitions/typeName" },
        "from": { "$ref": "#/definitions/identifier" },
        "to": { "$ref": "#/definitions/identifier" }
      }
    },
    "patternExistence": {
      "type": "object",
      "required": ["kind", "element"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Existence" },
        "element": { "$ref": "#/definitions/identifier" }
      }
    },
    "patternLet": {
      "type": "object",
      "required": ["kind", "variable", "expression"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Let" },
        "variable": { "$ref": "#/definitions/identifier" },
        "expression": { "$ref": "#/definitions/expression" }
      }
    },
    "patternCollection": {
      "type": "object",
      "required": ["kind", "variable", "collection"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Collection" },
        "variable": { "$ref": "#/definitions/identifier" },
        "collection": { "$ref": "#/definitions/collectionExpr" }
      }
    },
    "patternCondition": {
      "type": "object",
      "required": ["kind", "expression"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "Condition" },
        "expression": { "$ref": "#/definitions/expression" }
      }
    },
    "collectionExpr": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "Adjacency" },
            "node": { "$ref": "#/definitions/identifier" },
            "edge_type": { "$ref": "#/definitions/typeName" },
            "direction": { "enum": ["incoming", "outgoing"] }
          },
          "required": ["kind", "node", "edge_type", "direction"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Extent" },
            "type": { "$ref": "#/definitions/typeName" }
          },
          "required": ["kind", "type"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Sorted" },
            "source": { "$ref": "#/definitions/collectionExpr" },
            "by": { "type": "object", "required": ["field"], "properties": { "field": { "$ref": "#/definitions/identifier" } }, "additionalProperties": false }
          },
          "required": ["kind", "source", "by"],
          "additionalProperties": false
        }
      ]
    },
    "expression": {
      "type": "object",
      "required": ["kind"],
      "allOf": [
        { "$ref": "#/definitions/exprLiteral" },
        { "$ref": "#/definitions/exprVariable" },
        { "$ref": "#/definitions/exprFieldAccess" },
        { "$ref": "#/definitions/exprFunctionCall" },
        { "$ref": "#/definitions/exprArithmetic" },
        { "$ref": "#/definitions/exprComparison" },
        { "$ref": "#/definitions/exprBoolean" },
        { "$ref": "#/definitions/exprNot" },
        { "$ref": "#/definitions/exprConditional" },
        { "$ref": "#/definitions/exprMapLiteral" },
        { "$ref": "#/definitions/exprArray" }
      ]
    },
    "exprLiteral": {
      "if": { "properties": { "kind": { "const": "Literal" } } },
      "then": {
        "required": ["type", "value"],
        "properties": {
          "kind": { "const": "Literal" },
          "type": { "enum": ["Boolean", "Integer", "String", "Identifier"] },
          "value": { "type": ["boolean", "integer", "string"] }
        }
      }
    },
    "exprVariable": {
      "if": { "properties": { "kind": { "const": "Variable" } } },
      "then": {
        "required": ["name"],
        "properties": {
          "kind": { "const": "Variable" },
          "name": { "$ref": "#/definitions/identifier" }
        }
      }
    },
    "exprFieldAccess": {
      "if": { "properties": { "kind": { "const": "FieldAccess" } } },
      "then": {
        "required": ["variable", "field"],
        "properties": {
          "kind": { "const": "FieldAccess" },
          "variable": { "$ref": "#/definitions/identifier" },
          "field": { "$ref": "#/definitions/identifier" }
        }
      }
    },
    "exprFunctionCall": {
      "if": { "properties": { "kind": { "const": "FunctionCall" } } },
      "then": {
        "required": ["function", "arguments"],
        "properties": {
          "kind": { "const": "FunctionCall" },
          "function": { "$ref": "#/definitions/identifier" },
          "arguments": { "type": "array", "items": { "$ref": "#/definitions/expression" } }
        }
      }
    },
    "exprArithmetic": {
      "if": { "properties": { "kind": { "enum": ["Add","Subtract","Multiply","Divide","Modulo"] } } },
      "then": {
        "required": ["left", "right"],
        "properties": {
          "left": { "$ref": "#/definitions/expression" },
          "right": { "$ref": "#/definitions/expression" }
        }
      }
    },
    "exprComparison": {
      "if": { "properties": { "kind": { "enum": ["Equal","NotEqual","Less","LessEqual","Greater","GreaterEqual"] } } },
      "then": {
        "required": ["left", "right"],
        "properties": {
          "left": { "$ref": "#/definitions/expression" },
          "right": { "$ref": "#/definitions/expression" }
        }
      }
    },
    "exprBoolean": {
      "if": { "properties": { "kind": { "enum": ["And","Or"] } } },
      "then": {
        "required": ["left", "right"],
        "properties": {
          "left": { "$ref": "#/definitions/expression" },
          "right": { "$ref": "#/definitions/expression" }
        }
      }
    },
    "exprNot": {
      "if": { "properties": { "kind": { "const": "Not" } } },
      "then": {
        "required": ["operand"],
        "properties": {
          "kind": { "const": "Not" },
          "operand": { "$ref": "#/definitions/expression" }
        }
      }
    },
    "exprConditional": {
      "if": { "properties": { "kind": { "const": "Conditional" } } },
      "then": {
        "required": ["condition", "then", "else"],
        "properties": {
          "kind": { "const": "Conditional" },
          "condition": { "$ref": "#/definitions/expression" },
          "then": { "$ref": "#/definitions/expression" },
          "else": { "$ref": "#/definitions/expression" }
        }
      }
    },
    "exprMapLiteral": {
      "if": { "properties": { "kind": { "const": "MapLiteral" } } },
      "then": {
        "required": ["entries"],
        "properties": {
          "kind": { "const": "MapLiteral" },
          "entries": {
            "type": "object",
            "additionalProperties": { "$ref": "#/definitions/expression" }
          }
        }
      }
    },
    "exprArray": {
      "if": { "properties": { "kind": { "const": "Array" } } },
      "then": {
        "required": ["elements"],
        "properties": {
          "kind": { "const": "Array" },
          "elements": { "type": "array", "items": { "$ref": "#/definitions/expression" } }
        }
      }
    },
    "action": {
      "oneOf": [
        { "$ref": "#/definitions/actionCreateNode" },
        { "$ref": "#/definitions/actionCreateEdge" },
        { "$ref": "#/definitions/actionUpdateField" },
        { "$ref": "#/definitions/actionDeleteNode" },
        { "$ref": "#/definitions/actionDeleteEdge" },
        { "$ref": "#/definitions/actionEmitEvent" }
      ]
    },
    "actionCreateNode": {
      "type": "object",
      "required": ["action", "type", "fields"],
      "additionalProperties": false,
      "properties": {
        "action": { "const": "CreateNode" },
        "type": { "$ref": "#/definitions/typeName" },
        "fields": { "$ref": "#/definitions/fieldValueMap" }
      }
    },
    "actionCreateEdge": {
      "type": "object",
      "required": ["action", "edge_type", "source", "target", "fields"],
      "additionalProperties": false,
      "properties": {
        "action": { "const": "CreateEdge" },
        "edge_type": { "$ref": "#/definitions/typeName" },
        "source": { "$ref": "#/definitions/identifier" },
        "target": { "$ref": "#/definitions/identifier" },
        "fields": { "$ref": "#/definitions/fieldValueMap" }
      }
    },
    "actionUpdateField": {
      "type": "object",
      "required": ["action", "element", "field", "value"],
      "additionalProperties": false,
      "properties": {
        "action": { "const": "UpdateField" },
        "element": { "$ref": "#/definitions/identifier" },
        "field": { "$ref": "#/definitions/identifier" },
        "value": { "$ref": "#/definitions/expression" }
      }
    },
    "actionDeleteNode": {
      "type": "object",
      "required": ["action", "node"],
      "additionalProperties": false,
      "properties": {
        "action": { "const": "DeleteNode" },
        "node": { "$ref": "#/definitions/identifier" }
      }
    },
    "actionDeleteEdge": {
      "type": "object",
      "required": ["action", "edge"],
      "additionalProperties": false,
      "properties": {
        "action": { "const": "DeleteEdge" },
        "edge": { "$ref": "#/definitions/identifier" }
      }
    },
    "actionEmitEvent": {
      "type": "object",
      "required": ["action", "event_type", "payload"],
      "additionalProperties": false,
      "properties": {
        "action": { "const": "EmitEvent" },
        "event_type": { "$ref": "#/definitions/identifier" },
        "payload": { "$ref": "#/definitions/expression" }
      }
    },
    "fieldValueMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/expression" }
    },
    "constants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "value"],
        "additionalProperties": false,
        "properties": {
          "type": { "$ref": "#/definitions/typeExpr" },
          "value": { "$ref": "#/definitions/expression" }
        }
      }
    }
  }
}