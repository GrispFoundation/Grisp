{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/grisp-runtime-profile-v1.2.json",
  "title": "GRISP Runtime Profile Schema v1.2",
  "description": "Runtime profile schema for GRISP v1.2. Runtime profiles are operational policy documents that are merged with the Canonical IR at execution time. This schema distinguishes selection-affecting fields (which can influence deterministic selection) from operational-only fields. Engines must validate profiles against this schema before merging.",
  "type": "object",
  "required": ["profile_id", "profile_version", "engine"],
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "Stable identifier for the runtime profile."
    },
    "profile_version": {
      "type": "string",
      "description": "Semantic version of the profile."
    },
    "engine": {
      "type": "string",
      "description": "Engine name or compatibility target (e.g., 'reference', 'delphi', 'rust')."
    },
    "compatibility": {
      "type": "string",
      "enum": ["reference", "best-effort", "engine-specific"],
      "default": "best-effort",
      "description": "Compatibility level. 'reference' indicates the profile targets the Reference Scheduler Profile and must pass manifest-verify --compatibility=reference."
    },
    "selection_affecting_defaults": {
      "type": "object",
      "description": "Default selection-affecting parameters applied when rules do not override them.",
      "additionalProperties": false,
      "properties": {
        "scheduler": {
          "type": "object",
          "properties": {
            "fairness_window": { "type": "integer", "minimum": 1, "default": 20 },
            "matchAge_boost_alpha": { "type": "number", "minimum": 0, "default": 0.02 },
            "baseline_priority": { "type": "integer", "default": 50 },
            "tie_breaker": {
              "type": "string",
              "enum": ["rule_name", "match_key", "random"],
              "default": "rule_name",
              "description": "Deterministic tie-breaker; 'random' allowed only for engine-specific profiles and must be seeded deterministically for reference compatibility."
            }
          },
          "additionalProperties": false
        },
        "rate_limit": {
          "type": "object",
          "properties": {
            "max_per_tick": { "type": "integer", "minimum": 0 },
            "max_concurrent": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "Per-rule runtime settings. Keys are rule names or rule IDs from the Canonical IR.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "selection_affecting": {
            "type": "boolean",
            "description": "Advisory. Engines must derive selection impact from declared/inferred reads/writes; this flag is a hint for tooling."
          },
          "declared_reads": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "description": "Author-declared read set for production mode. Must be a superset of inferred_reads."
          },
          "declared_writes": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "description": "Author-declared write set for production mode. Must be a superset of inferred_writes."
          },
          "rate_limit": {
            "type": "object",
            "properties": {
              "max_per_tick": { "type": "integer", "minimum": 0 },
              "max_concurrent": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "scheduler_overrides": {
            "type": "object",
            "properties": {
              "priority_boost": { "type": "integer", "description": "Additive priority boost for selection scoring." },
              "fairness_window": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "lease": {
            "type": "object",
            "description": "Lease-related defaults for rules that create or manage leases.",
            "properties": {
              "default_ttl_ms": { "type": "integer", "minimum": 0 },
              "heartbeat_interval_ms": { "type": "integer", "minimum": 0 },
              "steal_grace_period_ms": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "hooks": {
            "type": "object",
            "properties": {
              "after_commit": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string" },
                    "idempotent": { "type": "boolean", "default": false },
                    "timeout_ms": { "type": "integer", "minimum": 0 },
                    "retry_policy": { "type": "string" },
                    "non_deterministic": { "type": "boolean", "default": true }
                  },
                  "additionalProperties": false
                }
              },
              "on_failure": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string" },
                    "idempotent": { "type": "boolean", "default": false },
                    "timeout_ms": { "type": "integer", "minimum": 0 },
                    "retry_policy": { "type": "string" },
                    "non_deterministic": { "type": "boolean", "default": true }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "custom": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Optional hints for capability closure materialization.",
      "properties": {
        "materialize_closure": { "type": "boolean", "default": false },
        "closure_refresh_interval_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "emit_level": { "type": "string", "enum": ["none", "minimal", "detailed"], "default": "minimal" },
        "event_retention": {
          "type": "object",
          "properties": {
            "audit_days": { "type": "integer", "minimum": 0 },
            "operational_days": { "type": "integer", "minimum": 0 },
            "debug_days": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "description": "Operational safety defaults.",
      "properties": {
        "production_mode": { "type": "boolean", "default": false },
        "declared_sets_required": { "type": "boolean", "default": false },
        "max_transaction_size": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "custom": { "type": "object", "additionalProperties": true }
  }
}
