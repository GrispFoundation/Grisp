{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/grisp-expression-ast-v1.2.json",
  "title": "GRISP Expression AST Schema v1.2",
  "description": "Canonical, validation-grade JSON Schema for GRISP v1.2 expression AST nodes. All values in the Canonical IR must be represented as expression nodes conforming to this schema.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/literal" },
    { "$ref": "#/definitions/var_ref" },
    { "$ref": "#/definitions/field_access" },
    { "$ref": "#/definitions/call" },
    { "$ref": "#/definitions/binary_op" },
    { "$ref": "#/definitions/unary_op" },
    { "$ref": "#/definitions/conditional" },
    { "$ref": "#/definitions/collection_expr" },
    { "$ref": "#/definitions/object_expr" },
    { "$ref": "#/definitions/array_expr" }
  ],
  "definitions": {
    "base_expr": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "type_hint": {
          "type": ["string", "null"],
          "description": "Optional static type hint (e.g., 'integer','string','Task'). Not required for runtime typing but useful for validation and optimization."
        },
        "meta": {
          "type": "object",
          "description": "Optional metadata for tooling (non-normative). Engines must ignore unknown meta fields.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "literal": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "literal_type", "value"],
          "properties": {
            "kind": { "const": "literal" },
            "literal_type": {
              "type": "string",
              "enum": ["integer", "number", "string", "boolean", "null"]
            },
            "value": {},
            "format_hint": {
              "type": "string",
              "description": "Optional formatting hint (e.g., 'iso8601' for timestamps)."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "var_ref": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "var" },
            "name": { "type": "string", "minLength": 1 },
            "namespace": {
              "type": "string",
              "description": "Optional namespace for cross-scope references."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "field_access": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "var", "field"],
          "properties": {
            "kind": { "const": "field" },
            "var": { "type": "string", "minLength": 1 },
            "field": { "type": "string", "minLength": 1 },
            "safe": {
              "type": "boolean",
              "default": false,
              "description": "If true, field access returns null when missing instead of erroring."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "call": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "fn"],
          "properties": {
            "kind": { "const": "call" },
            "fn": { "type": "string", "minLength": 1 },
            "args": {
              "type": "array",
              "items": { "$ref": "#" },
              "default": []
            },
            "kwargs": {
              "type": "object",
              "additionalProperties": { "$ref": "#" },
              "description": "Optional named arguments; keys are argument names."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "binary_op": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "op", "left", "right"],
          "properties": {
            "kind": { "const": "binary" },
            "op": {
              "type": "string",
              "enum": [
                "+", "-", "*", "/", "%", "==", "!=", "<", ">", "<=", ">=",
                "and", "or", "in", "not_in", "contains"
              ]
            },
            "left": { "$ref": "#" },
            "right": { "$ref": "#" }
          },
          "additionalProperties": false
        }
      ]
    },
    "unary_op": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "op", "operand"],
          "properties": {
            "kind": { "const": "unary" },
            "op": { "type": "string", "enum": ["-", "not"] },
            "operand": { "$ref": "#" }
          },
          "additionalProperties": false
        }
      ]
    },
    "conditional": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "cond", "then", "else"],
          "properties": {
            "kind": { "const": "conditional" },
            "cond": { "$ref": "#" },
            "then": { "$ref": "#" },
            "else": { "$ref": "#" }
          },
          "additionalProperties": false
        }
      ]
    },
    "collection_expr": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "source"],
          "properties": {
            "kind": { "const": "collection" },
            "source": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "query": { "type": "object", "description": "Optional structured query constraints (normalized form)." }
              },
              "additionalProperties": true
            },
            "order_by": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["field", "direction"],
                "properties": {
                  "field": { "type": "string" },
                  "direction": { "type": "string", "enum": ["asc", "desc"] }
                },
                "additionalProperties": false
              },
              "default": []
            },
            "limit": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "object_expr": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "fields"],
          "properties": {
            "kind": { "const": "object" },
            "fields": {
              "type": "object",
              "additionalProperties": { "$ref": "#" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "array_expr": {
      "allOf": [
        { "$ref": "#/definitions/base_expr" },
        {
          "type": "object",
          "required": ["kind", "items"],
          "properties": {
            "kind": { "const": "array" },
            "items": {
              "type": "array",
              "items": { "$ref": "#" }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "examples": [
    { "kind": "literal", "literal_type": "integer", "value": 30000 },
    { "kind": "var", "name": "Task" },
    { "kind": "field", "var": "Task", "field": "id" },
    {
      "kind": "binary",
      "op": "+",
      "left": { "kind": "var", "name": "TickStartTime" },
      "right": { "kind": "literal", "literal_type": "integer", "value": 30000 }
    },
    {
      "kind": "call",
      "fn": "NextLeaseEpoch",
      "args": [ { "kind": "var", "name": "Task" } ]
    },
    {
      "kind": "object",
      "fields": {
        "task": { "kind": "var", "name": "Task" },
        "agent": { "kind": "var", "name": "Agent" }
      }
    }
  ],
  "notes": "All expression nodes MUST include 'kind'. Literal nodes MUST include 'literal_type'. Engines and manifest-compile must normalize all values into expression nodes before emitting the Canonical IR. Unknown additional properties in 'meta' are allowed for tooling but must be ignored by engines for execution semantics."
}
