{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/grisp-canonical-ir-v1.2.schema.json",
  "title": "GRISP Canonical IR v1.2 Schema",
  "description": "Machine-readable JSON Schema for the GRISP Canonical IR v1.2. Use this schema to validate manifests emitted by manifest-compile.",
  "type": "object",
  "required": ["ir_version", "manifest_id", "manifest_version", "nodes", "edges", "functions", "rules"],
  "additionalProperties": false,
  "properties": {
    "ir_version": { "type": "string", "const": "grisp-v1.2" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "manifest_version": { "type": "string", "minLength": 1 },
    "id_generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["sha256_canonical_json", "explicit_field", "namespace_hash"] },
        "details": { "type": "string" }
      }
    },
    "metadata": { "type": "object", "additionalProperties": true },
    "runtime_profile_ref": { "type": ["string", "null"] },
    "nodes": { "type": "array", "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } },
    "functions": { "type": "array", "items": { "$ref": "#/definitions/function" } },
    "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } },
    "constraints": { "type": "array", "items": { "$ref": "#/definitions/constraint" } },
    "custom": { "type": "object", "additionalProperties": true }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["name", "fields"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "fields": {
          "type": "object",
          "minProperties": 0,
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "required": ["enum"],
                    "additionalProperties": false,
                    "properties": {
                      "enum": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                    }
                  }
                ]
              },
              "optional": { "type": "boolean", "default": false },
              "indexed": { "type": "boolean", "default": false },
              "description": { "type": "string" },
              "custom": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "constraints": { "type": "array", "items": { "$ref": "#/definitions/constraint" } },
        "custom": { "type": "object", "additionalProperties": true }
      }
    },
    "edge": {
      "type": "object",
      "required": ["name", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "acyclic": { "type": "boolean", "default": false },
        "description": { "type": "string" },
        "custom": { "type": "object", "additionalProperties": true }
      }
    },
    "function": {
      "type": "object",
      "required": ["name", "kind", "signature"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["pure", "effect", "nondeterministic"] },
        "signature": { "type": "string" },
        "external": { "type": "boolean", "default": true },
        "implementation": { "type": ["string", "null"] },
        "effect_meta": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "idempotent": { "type": "boolean" },
            "timeout_ms": { "type": "integer", "minimum": 0 },
            "on_timeout": { "type": "string", "enum": ["retry", "fail", "return_default", "propagate", "escalate"] }
          }
        },
        "description": { "type": "string" },
        "custom": { "type": "object", "additionalProperties": true }
      }
    },
    "rule": {
      "type": "object",
      "required": ["name", "priority", "when", "then", "inferred_reads", "inferred_writes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "priority": { "type": "integer" },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "idempotent": { "type": "boolean" },
            "depends_on": { "type": "array", "items": { "type": "string" } },
            "emits": { "type": "array", "items": { "type": "string" } }
          }
        },
        "when": { "type": "array", "items": { "$ref": "#/definitions/pattern" } },
        "then": { "type": "array", "items": { "$ref": "#/definitions/action" } },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "after_commit": { "type": "array", "items": { "$ref": "#/definitions/hook" } },
            "on_failure": { "type": "array", "items": { "$ref": "#/definitions/hook" } }
          }
        },
        "inferred_reads": { "type": "array", "items": { "type": "string" } },
        "inferred_writes": { "type": "array", "items": { "type": "string" } },
        "declared_reads": { "type": ["array", "null"], "items": { "type": "string" } },
        "declared_writes": { "type": ["array", "null"], "items": { "type": "string" } },
        "selection_affecting_hint": { "type": ["boolean", "null"] },
        "custom": { "type": "object", "additionalProperties": true }
      }
    },
    "hook": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "idempotent": { "type": "boolean", "default": false },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "retry_policy": { "type": "string" },
        "non_deterministic": { "type": "boolean", "default": true },
        "custom": { "type": "object", "additionalProperties": true }
      }
    },
    "constraint": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "target": { "type": ["string", "array"] },
        "where": { "$ref": "#/definitions/expression" }
      }
    },
    "pattern": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["binding", "edge", "existence", "let", "collection", "condition"] },
        "var": { "type": "string" },
        "type": { "type": "string" },
        "constraints": { "type": "array", "items": { "$ref": "#/definitions/constraint_item" } },
        "edge": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "exists": { "type": "boolean" },
        "pattern": { "$ref": "#/definitions/pattern" },
        "let_name": { "type": "string" },
        "expr": { "$ref": "#/definitions/expression" },
        "collection": {
          "type": "object",
          "required": ["var", "type"],
          "additionalProperties": false,
          "properties": {
            "var": { "type": "string" },
            "type": { "type": "string" },
            "constraints": { "type": "array", "items": { "$ref": "#/definitions/constraint_item" } },
            "order_by": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["field", "direction"],
                "additionalProperties": false,
                "properties": {
                  "field": { "type": "string" },
                  "direction": { "type": "string", "enum": ["asc", "desc"] }
                }
              }
            },
            "limit": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "constraint_item": {
      "type": "object",
      "required": ["field", "op"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string" },
        "op": {
          "type": "string",
          "enum": ["eq", "neq", "lt", "lte", "gt", "gte", "bind", "eq_var", "in", "not_in", "contains", "regex", "typeof_eq", "expr", "not_null"]
        },
        "value": { "$ref": "#/definitions/expression" },
        "var": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["let", "update", "create", "delete", "emit", "for", "call", "if"] },
        "let_name": { "type": "string" },
        "expr": { "$ref": "#/definitions/expression" },
        "target": { "type": "string" },
        "type": { "type": "string" },
        "result_var": { "type": "string" },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/definitions/expression" } },
        "assigns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "value"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "value": { "$ref": "#/definitions/expression" }
            }
          }
        },
        "when": { "$ref": "#/definitions/expression" },
        "emit": {
          "type": "object",
          "required": ["type", "class"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "class": { "type": "string", "enum": ["audit", "operational", "debug"] },
            "payload": { "type": "object", "additionalProperties": { "$ref": "#/definitions/expression" } },
            "emit_hint": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sample_rate": { "type": "number", "minimum": 0, "maximum": 1 },
                "aggregate_key": { "type": "string" }
              }
            },
            "non_deterministic": { "type": "boolean", "default": false }
          }
        },
        "for": {
          "type": "object",
          "required": ["var", "collection"],
          "additionalProperties": false,
          "properties": {
            "var": { "type": "string" },
            "collection": { "$ref": "#/definitions/expression" }
          }
        },
        "call": {
          "type": "object",
          "required": ["fn"],
          "additionalProperties": false,
          "properties": {
            "fn": { "type": "string" },
            "args": { "type": "array", "items": { "$ref": "#/definitions/expression" } },
            "kwargs": { "type": "object", "additionalProperties": { "$ref": "#/definitions/expression" } }
          }
        },
        "if": {
          "type": "object",
          "required": ["cond", "then"],
          "additionalProperties": false,
          "properties": {
            "cond": { "$ref": "#/definitions/expression" },
            "then": { "type": "array", "items": { "$ref": "#/definitions/action" } },
            "else": { "type": ["array", "null"], "items": { "$ref": "#/definitions/action" } }
          }
        }
      }
    },
    "expression": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "oneOf": [
        { "$ref": "#/definitions/literal" },
        { "$ref": "#/definitions/var_ref" },
        { "$ref": "#/definitions/field_access" },
        { "$ref": "#/definitions/call" },
        { "$ref": "#/definitions/binary_op" },
        { "$ref": "#/definitions/unary_op" },
        { "$ref": "#/definitions/conditional" },
        { "$ref": "#/definitions/collection_expr" },
        { "$ref": "#/definitions/object_expr" },
        { "$ref": "#/definitions/array_expr" }
      ]
    },
    "literal": {
      "type": "object",
      "required": ["kind", "literal_type", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "literal" },
        "literal_type": { "type": "string", "enum": ["integer", "number", "string", "boolean", "null"] },
        "value": {},
        "format_hint": { "type": "string" },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    "var_ref": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "var" },
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    "field_access": {
      "type": "object",
      "required": ["kind", "var", "field"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "field" },
        "var": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/definitions/field_access" },
            { "$ref": "#/definitions/var_ref" }
          ]
        },
        "field": { "type": "string" },
        "safe": { "type": "boolean", "default": false },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    "call": {
      "type": "object",
      "required": ["kind", "fn"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "call" },
        "fn": { "type": "string" },
        "args": { "type": "array", "items": { "$ref": "#/definitions/expression" }, "default": [] },
        "kwargs": { "type": "object", "additionalProperties": { "$ref": "#/definitions/expression" } },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    "binary_op": {
      "type": "object",
      "required": ["kind", "op", "left", "right"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "binary" },
        "op": {
          "type": "string",
          "enum": ["+", "-", "*", "/", "%", "==", "!=", "<", ">", "<=", ">=", "and", "or", "in", "not_in", "contains"]
        },
        "left": { "$ref": "#/definitions/expression" },
        "right": { "$ref": "#/definitions/expression" },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    "unary_op": {
      "type": "object",
      "required": ["kind", "op", "operand"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "unary" },
        "op": { "type": "string", "enum": ["-", "not"] },
        "operand": { "$ref": "#/definitions/expression" },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    "conditional": {
      "type": "object",
      "required": ["kind", "cond", "then", "else"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "conditional" },
        "cond": { "$ref": "#/definitions/expression" },
        "then": { "$ref": "#/definitions/expression" },
        "else": { "$ref": "#/definitions/expression" },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    "collection_expr": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "collection" },
        "source": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" },
            "query": { "type": "object", "additionalProperties": true }
          }
        },
        "order_by": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "direction"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "direction": { "type": "string", "enum": ["asc", "desc"] }
            }
          },
          "default": []
        },
        "limit": { "type": "integer", "minimum": 1 },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    "object_expr": {
      "type": "object",
      "required": ["kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "object" },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/definitions/expression" } },
        "meta": { "type": "object", "additionalProperties": true }
      }
    },
    "array_expr": {
      "type": "object",
      "required": ["kind", "items"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "array" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/expression" } },
        "meta": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
