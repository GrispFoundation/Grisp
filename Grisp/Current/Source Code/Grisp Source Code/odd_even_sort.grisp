//////////////////////////////////////////////////////////////
// demo: odd_even_sort.grisp
// algorithm: Odd-Even Sort
// description: Alternates odd and even index swaps.
// version: 1.0
// author: Skybuck
//////////////////////////////////////////////////////////////

// --- List definition ---
node N1  { value: number = 9; next: identifier = N2; index: number = 1 }
node N2  { value: number = 3; next: identifier = N3; index: number = 2 }
node N3  { value: number = 7; next: identifier = N4; index: number = 3 }
node N4  { value: number = 1; next: identifier = N5; index: number = 4 }
node N5  { value: number = 8; next: identifier = N6; index: number = 5 }
node N6  { value: number = 2; next: identifier = N7; index: number = 6 }
node N7  { value: number = 5; next: identifier = N8; index: number = 7 }
node N8  { value: number = 4; next: identifier = N9; index: number = 8 }
node N9  { value: number = 6; next: identifier = N10; index: number = 9 }
node N10 { value: number = 0; index: number = 10 }

// --- Odd phase ---
node rule.odd_swap {
    match: node = {
        X: node = { index: number = IX; value: number = VX; next: identifier = Y }
        Y: node = { value: number = VY }
    }
    rewrite: node = {
        X: node = { index: number = IX; value: number = VY; next: identifier = Y }
        Y: node = { value: number = VX }
    }
}

// --- Even phase ---
node rule.even_swap {
    match: node = {
        X: node = { index: number = IX; value: number = VX; next: identifier = Y }
        Y: node = { value: number = VY }
    }
    rewrite: node = {
        X: node = { index: number = IX; value: number = VY; next: identifier = Y }
        Y: node = { value: number = VX }
    }
}
