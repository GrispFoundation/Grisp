//////////////////////////////////////////////////////////////
// demo: wave_sort.grisp
// algorithm: Wave Sort (GRISP-native)
// description: A self-stabilizing sorting algorithm based on
//              propagating correction waves through the graph.
// version: 1.0
// author: Skybuck
//////////////////////////////////////////////////////////////

// --- List definition (10 elements) ---
node N1  { value: number = 9; next: identifier = N2 }
node N2  { value: number = 3; next: identifier = N3 }
node N3  { value: number = 7; next: identifier = N4 }
node N4  { value: number = 1; next: identifier = N5 }
node N5  { value: number = 8; next: identifier = N6 }
node N6  { value: number = 2; next: identifier = N7 }
node N7  { value: number = 5; next: identifier = N8 }
node N8  { value: number = 4; next: identifier = N9 }
node N9  { value: number = 6; next: identifier = N10 }
node N10 { value: number = 0 }

// ----------------------------------------------------------
// Wave Sort Rules
// ----------------------------------------------------------

// --- Rule 1: Emit a left-wave if X should move left ---
node rule.wave_left {
    match: node = {
        P: node = { value: number = VP; next: identifier = X }
        X: node = { value: number = VX }
    }
    rewrite: node = {
        P: node = { value: number = VX; next: identifier = X }
        X: node = { value: number = VP }
    }
}

// --- Rule 2: Emit a right-wave if X should move right ---
node rule.wave_right {
    match: node = {
        X: node = { value: number = VX; next: identifier = N }
        N: node = { value: number = VN }
    }
    rewrite: node = {
        X: node = { value: number = VN; next: identifier = N }
        N: node = { value: number = VX }
    }
}
