# ===================================================
# GRISP - Agent Collaboration Protocol (Version 0.03)
# Goals, retries, clean assignment, and strategy
# ===================================================

namespace AgentCollaborationV003 {

    # ======================
    # Core Entity Types
    # ======================

    node Agent {
        id: identifier
        role: ("Planner" | "Specialist")
        capabilities: array<identifier>      # e.g. ["plan", "code", "search", "execute", "tool_call"]
        # state is now derived from graph (assigned edges), not authoritative
    }

    node Goal {
        id: identifier
        description: string
        status: ("pending" | "in_progress" | "completed" | "failed")
        created_at: number
        updated_at: number
        tags: array<identifier>
    }

    node Task {
        id: identifier
        description: string
        status: ("pending" | "assigned" | "in_progress" | "waiting_tool" | "completed" | "failed")
        priority: number
        created_at: number
        updated_at: number
        retries: number
        max_retries: number
        result: value?
        error: string?
        tags: array<identifier>
    }

    node Message {
        id: identifier
        type: identifier                      # "TaskAssigned" | "TaskCompleted" | "TaskFailed" | "TaskRetryScheduled" | "GoalCompleted" | "GoalFailed"
        from: node<Agent>
        to: node<Agent>
        payload: node<Task>?
        goal: node<Goal>?
    }

    node ToolRequest {
        id: identifier
        kind: ("WebSearch" | "CodeExecution")
        input: value
        status: ("pending" | "running" | "completed" | "failed")
        created_at: number
        task: node<Task>
    }

    node ToolResult {
        id: identifier
        request: node<ToolRequest>
        success: boolean
        data: value?
        error: string?
    }

    node FinalAnswer {
        id: identifier
        goal: node<Goal>
        content: value
        confidence: number
        source_tasks: array<node<Task>>
    }

    # ======================
    # Structural Edges
    # ======================

    edge assigns {
        from: Agent
        to: Task
        label: "assigned"
        type: "agent_task"
    }

    edge belongs_to_goal {
        from: Task
        to: Goal
        label: "belongs_to"
        type: "task_goal"
    }

    edge communicates {
        from: Agent
        to: Message
        label: "sends"
        type: "agent_message"
    }

    edge about_task {
        from: Message
        to: Task
        label: "about"
        type: "message_task"
    }

    edge about_goal {
        from: Message
        to: Goal
        label: "about_goal"
        type: "message_goal"
    }

    edge tool_for_task {
        from: ToolRequest
        to: Task
        label: "for"
        type: "tool_task"
    }

    edge result_of_request {
        from: ToolResult
        to: ToolRequest
        label: "result_of"
        type: "tool_result"
    }

    # ======================
    # Core Agentic Rules
    # ======================

    # Rule 1: Planner delegates a pending task of a goal to a capable Specialist
    node rule.DelegateTask {
        match: graph = {
            Planner: node = {
                role = "Planner"
            }

            Goal: node = {
                status in ["pending", "in_progress"]
            }

            Task: node = {
                status = "pending"
                retries <= max_retries
            }

            edge belongs_to_goal {
                from: Task
                to: Goal
            }

            Specialist: node = {
                role = "Specialist"
                capabilities contains "execute"
            }

            # Specialist is considered idle if it has no assigns edge to an active task
            not exists edge assigns {
                from: Specialist
                to: AnyTask where AnyTask.status in ["assigned", "in_progress", "waiting_tool"]
            }
        }

        rewrite: graph = {
            Planner: node = {
                role = "Planner"
            }

            Goal: node = {
                status = "in_progress"
                updated_at = Now()
            }

            Task: node = {
                status = "assigned"
                updated_at = Now()
            }

            edge assigns {
                from: Specialist
                to: Task
            }

            Msg: node = {
                type = "TaskAssigned"
                from = Planner
                to = Specialist
                payload = Task
                goal = Goal
            }

            edge communicates {
                from: Planner
                to: Msg
            }

            edge about_task {
                from: Msg
                to: Task
            }

            edge about_goal {
                from: Msg
                to: Goal
            }
        }
    }

    # Rule 2: Specialist starts working on an assigned task
    node rule.StartTaskWork {
        match: graph = {
            Specialist: node = {
                role = "Specialist"
            }

            Task: node = {
                status = "assigned"
            }

            edge assigns {
                from: Specialist
                to: Task
            }
        }

        rewrite: graph = {
            Specialist: node = {
                role = "Specialist"
            }

            Task: node = {
                status = "in_progress"
                updated_at = Now()
            }
        }
    }

    # Rule 3: Specialist decides a tool is needed and creates a ToolRequest
    node rule.CreateToolRequest {
        match: graph = {
            Specialist: node = {
                role = "Specialist"
                capabilities contains "tool_call"
            }

            Task: node = {
                status = "in_progress"
                description = Desc
            }

            edge assigns {
                from: Specialist
                to: Task
            }

            # Prevent duplicate tool requests for the same task
            not exists ToolReq: node = ToolRequest {
                task = Task
                status in ["pending", "running"]
            }
        }

        rewrite: graph = {
            Specialist: node = {
                role = "Specialist"
            }

            Task: node = {
                status = "waiting_tool"
                updated_at = Now()
            }

            ToolReq: node = ToolRequest {
                id = NewId()
                kind = DecideToolKind(Desc)
                input = Desc
                status = "pending"
                created_at = Now()
                task = Task
            }

            edge tool_for_task {
                from: ToolReq
                to: Task
            }
        }
    }

    # Rule 4: Runtime marks a pending ToolRequest as running (side-effect boundary)
    node rule.MarkToolRunning {
        match: graph = {
            ToolReq: node = ToolRequest {
                status = "pending"
            }
        }

        rewrite: graph = {
            ToolReq: node = ToolRequest {
                status = "running"
            }
        }
    }

    # Rule 5: Integrate successful ToolResult, complete task, clean assignment
    node rule.IntegrateToolResultSuccess {
        match: graph = {
            ToolRes: node = ToolResult {
                success = true
                request = ToolReq
            }

            ToolReq: node = ToolRequest {
                status = "completed"
                task = Task
            }

            Task: node = {
                status = "waiting_tool"
            }

            Specialist: node = {
                role = "Specialist"
            }

            edge assigns {
                from: Specialist
                to: Task
            }

            Goal: node = {
                status in ["pending", "in_progress"]
            }

            edge belongs_to_goal {
                from: Task
                to: Goal
            }

            Planner: node = {
                role = "Planner"
            }
        }

        rewrite: graph = {
            Task: node = {
                status = "completed"
                result = ToolRes.data
                updated_at = Now()
                error = ""
            }

            Planner: node = {
                role = "Planner"
            }

            Goal: node = {
                status = Goal.status   # may be updated by synthesis later
            }

            edge result_of_request {
                from: ToolRes
                to: ToolReq
            }

            # Remove assignment edge: specialist is now free for other tasks
            delete edge assigns {
                from: Specialist
                to: Task
            }

            Msg: node = {
                type = "TaskCompleted"
                from = Specialist
                to = Planner
                payload = Task
                goal = Goal
            }

            edge communicates {
                from: Specialist
                to: Msg
            }

            edge about_task {
                from: Msg
                to: Task
            }

            edge about_goal {
                from: Msg
                to: Goal
            }
        }
    }

    # Rule 6: Integrate failed ToolResult, retry or fail task, clean assignment when done
    node rule.IntegrateToolResultFailure {
        match: graph = {
            ToolRes: node = ToolResult {
                success = false
                request = ToolReq
            }

            ToolReq: node = ToolRequest {
                status = "failed"
                task = Task
            }

            Task: node = {
                status = "waiting_tool"
            }

            Specialist: node = {
                role = "Specialist"
            }

            edge assigns {
                from: Specialist
                to: Task
            }

            Goal: node = {
                status in ["pending", "in_progress"]
            }

            edge belongs_to_goal {
                from: Task
                to: Goal
            }

            Planner: node = {
                role = "Planner"
            }
        }

        rewrite: graph = {
            Task: node = {
                status = (Task.retries + 1 <= Task.max_retries) ? "pending" : "failed"
                retries = Task.retries + 1
                error = ToolRes.error
                updated_at = Now()
            }

            Planner: node = {
                role = "Planner"
            }

            Goal: node = {
                status = Goal.status
            }

            edge result_of_request {
                from: ToolRes
                to: ToolReq
            }

            # If task is permanently failed, free the specialist
            maybe delete edge assigns {
                from: Specialist
                to: Task
            } when Task.status = "failed"

            Msg: node = {
                type = (Task.retries + 1 <= Task.max_retries) ? "TaskRetryScheduled" : "TaskFailed"
                from = Specialist
                to = Planner
                payload = Task
                goal = Goal
            }

            edge communicates {
                from: Specialist
                to: Msg
            }

            edge about_task {
                from: Msg
                to: Task
            }

            edge about_goal {
                from: Msg
                to: Goal
            }
        }
    }

    # Rule 7: Fail a goal if any of its tasks has permanently failed
    node rule.FailGoal {
        match: graph = {
            Goal: node = {
                status in ["pending", "in_progress"]
            }

            FailedTask: node = {
                status = "failed"
            }

            edge belongs_to_goal {
                from: FailedTask
                to: Goal
            }

            Planner: node = {
                role = "Planner"
            }
        }

        rewrite: graph = {
            Goal: node = {
                status = "failed"
                updated_at = Now()
            }

            Planner: node = {
                role = "Planner"
            }

            Msg: node = {
                type = "GoalFailed"
                from = Planner
                to = Planner
                goal = Goal
            }

            edge about_goal {
                from: Msg
                to: Goal
            }
        }
    }

    # Rule 8: Planner synthesizes results for a single goal into a FinalAnswer
    node rule.SynthesizeGoalResults {
        match: graph = {
            Planner: node = {
                role = "Planner"
            }

            Goal: node = {
                status in ["pending", "in_progress"]
            }

            # All tasks for this goal must be completed (no pending/assigned/in_progress/waiting_tool/failed)
            condition AllTasksCompleted(Goal) = true

            CompletedTasks: many node = {
                status = "completed"
            }

            edges: many belongs_to_goal {
                from: CompletedTasks
                to: Goal
            }
        }

        rewrite: graph = {
            Planner: node = {
                role = "Planner"
            }

            Goal: node = {
                status = "completed"
                updated_at = Now()
            }

            Answer: node = FinalAnswer {
                id = NewId()
                goal = Goal
                content = MergeResults(CompletedTasks)
                confidence = CalculateConfidence(CompletedTasks)
                source_tasks = CompletedTasks
            }

            Msg: node = {
                type = "GoalCompleted"
                from = Planner
                to = Planner
                goal = Goal
            }

            edge about_goal {
                from: Msg
                to: Goal
            }
        }
    }

    # ======================
    # Strategy (Execution Semantics)
    # ======================

    strategy AgentLoop {
        repeat {
            phase 1 {
                apply DelegateTask;
            }
            phase 2 {
                apply StartTaskWork;
            }
            phase 3 {
                apply CreateToolRequest;
            }
            phase 4 {
                apply MarkToolRunning;
                apply IntegrateToolResultSuccess;
                apply IntegrateToolResultFailure;
            }
            phase 5 {
                apply FailGoal;
                apply SynthesizeGoalResults;
            }
        }
    }

    # ======================
    # Pure Helper Functions
    # ======================

    fn Now(): number
    fn NewId(): identifier
    fn DecideToolKind(desc: string): ("WebSearch" | "CodeExecution")
    fn MergeResults(tasks: array<node<Task>>): value
    fn CalculateConfidence(tasks: array<node<Task>>): number
    fn AllTasksCompleted(goal: node<Goal>): boolean
}
