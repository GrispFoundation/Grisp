# GARP/1.24 Firefox AI Gateway.
#
# Keep the complete component in one moz.build.  This intentionally follows
# the proven EXTRA_JS_MODULES namespace technique used by the older GARP
# implementation: each dotted namespace becomes a subdirectory below
# $(FINAL_TARGET)/modules.

EXTRA_JS_MODULES.aistarter += [
    'AIAutomation.sys.mjs',
]

EXTRA_JS_MODULES.aistarter.actors += [
    'actors/AIAutomationChild.sys.mjs',
    'actors/AIAutomationParent.sys.mjs',
]

EXTRA_JS_MODULES.aistarter.diagnostics += [
    'diagnostics/AIAutomationDiagnostics.sys.mjs',
]

EXTRA_JS_MODULES.aistarter.garp += [
    'garp/GarpAuth.sys.mjs',
    'garp/GarpConnection.sys.mjs',
    'garp/GarpErrors.sys.mjs',
    'garp/GarpFrame.sys.mjs',
    'garp/GarpJson.sys.mjs',
    'garp/GarpRegistry.sys.mjs',
    'garp/GarpReplayStore.sys.mjs',
    'garp/GarpSchema.sys.mjs',
    'garp/GarpUtil.sys.mjs',
]

EXTRA_JS_MODULES.aistarter.providers += [
    'providers/ChatGPTAdapter.sys.mjs',
    'providers/ClaudeAdapter.sys.mjs',
    'providers/CopilotAdapter.sys.mjs',
    'providers/DeepSeekAdapter.sys.mjs',
    'providers/GeminiAdapter.sys.mjs',
    'providers/GrokAdapter.sys.mjs',
    'providers/InceptionAdapter.sys.mjs',
    'providers/PerplexityAdapter.sys.mjs',
    'providers/ProviderAdapter.sys.mjs',
    'providers/ProviderRegistry.sys.mjs',
]

EXTRA_JS_MODULES.aistarter.requests += [
    'requests/GarpRequest.sys.mjs',
    'requests/GarpRequestManager.sys.mjs',
]

EXTRA_JS_MODULES.aistarter.sessions += [
    'sessions/AIAutomationSession.sys.mjs',
    'sessions/AIAutomationSessionManager.sys.mjs',
]
