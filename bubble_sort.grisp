
//////////////////////////////////////////////////////////////
// demo: bubble_sort.grisp
// algorithm: Bubble Sort
// description: Sorts a 10-element list using adjacent swaps.
// version: 1.2
// author: Skybuck
// fix: Guarded swap with where VX > VY placed after rewrite
//////////////////////////////////////////////////////////////

// Simple bubble sort - one rule handles all swaps
node N1  { value: number = 9; next: identifier = N2 }
node N2  { value: number = 3; next: identifier = N3 }
node N3  { value: number = 7; next: identifier = N4 }
node N4  { value: number = 1; next: identifier = N5 }
node N5  { value: number = 8; next: identifier = N6 }
node N6  { value: number = 2; next: identifier = N7 }
node N7  { value: number = 5; next: identifier = N8 }
node N8  { value: number = 4; next: identifier = N9 }
node N9  { value: number = 6; next: identifier = N10 }
node N10 { value: number = 0; next: identifier = nil }

// Single rule that swaps any adjacent out-of-order pair
node rule.bubble_swap {
    match: node = {
        X: node = {
            value: number = VX
            next: identifier = Y
        }
        Y: node = {
            value: number = VY
        }
    }
    rewrite: node = {
        X: node = {
            value: number = VY
            next: identifier = Y
        }
        Y: node = {
            value: number = VX
        }
    }
    where VX > VY
}
