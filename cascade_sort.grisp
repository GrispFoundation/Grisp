//////////////////////////////////////////////////////////////
// demo: cascade_sort.grisp
// algorithm: Cascade Sort (GRISP-native, efficient)
// description: A parallel, self-stabilizing O(n log n) sorting
//              algorithm based on cascading merge waves.
// version: 1.0
// author: Skybuck
//////////////////////////////////////////////////////////////

// --- List definition (10 elements) ---
node N1  { value: number = 9; next: identifier = N2 }
node N2  { value: number = 3; next: identifier = N3 }
node N3  { value: number = 7; next: identifier = N4 }
node N4  { value: number = 1; next: identifier = N5 }
node N5  { value: number = 8; next: identifier = N6 }
node N6  { value: number = 2; next: identifier = N7 }
node N7  { value: number = 5; next: identifier = N8 }
node N8  { value: number = 4; next: identifier = N9 }
node N9  { value: number = 6; next: identifier = N10 }
node N10 { value: number = 0 }

// ----------------------------------------------------------
// Cascade Sort Rules
// ----------------------------------------------------------

// --- Rule 1: Local pairwise ordering (build sorted pockets) ---
node rule.local_order {
    match: node = {
        X: node = { value: number = VX; next: identifier = Y }
        Y: node = { value: number = VY }
    }
    rewrite: node = {
        X: node = { value: number = min(VX, VY); next: identifier = Y }
        Y: node = { value: number = max(VX, VY) }
    }
}

// --- Rule 2: Cascade merge boundary detection ---
node rule.cascade_boundary {
    match: node = {
        A: node = { value: number = VA; next: identifier = B }
        B: node = { value: number = VB; next: identifier = C }
        C: node = { value: number = VC }
    }
    rewrite: node = {
        A: node = { value: number = min(VA, VB); next: identifier = B }
        B: node = { value: number = mid(VA, VB, VC); next: identifier = C }
        C: node = { value: number = max(VB, VC) }
    }
}

// --- Rule 3: Cascade propagation (merge pockets) ---
node rule.cascade_propagate {
    match: node = {
        L: node = { value: number = VL; next: identifier = X }
        X: node = { value: number = VX; next: identifier = R }
        R: node = { value: number = VR }
    }
    rewrite: node = {
        L: node = { value: number = min(VL, VX); next: identifier = X }
        X: node = { value: number = mid(VL, VX, VR); next: identifier = R }
        R: node = { value: number = max(VX, VR) }
    }
}
