// selection_sort.grisp - NOW WITH EDGE DELETION!
// Uses remove_next to extract minimum node

node N1  { value: number = 9; next: identifier = N2 }
node N2  { value: number = 3; next: identifier = N3 }
node N3  { value: number = 7; next: identifier = N4 }
node N4  { value: number = 1; next: identifier = N5 }
node N5  { value: number = 8; next: identifier = N6 }
node N6  { value: number = 2; next: identifier = N7 }
node N7  { value: number = 5; next: identifier = N8 }
node N8  { value: number = 4; next: identifier = N9 }
node N9  { value: number = 6; next: identifier = N10 }
node N10 { value: number = 0; next: identifier = nil }

node SortedHead { next: identifier = nil }
node State { minVal: number = 999999; minNode: identifier = nil; scanPos: identifier = N1; pass: number = 1 }

// Find minimum
node rule.find_min {
    match: node = {
        State: node = { minVal: number = MV; scanPos: identifier = S };
        S: node = { value: number = V }
    }
    rewrite: node = {
        State: node = { minVal: number = V; minNode: identifier = S }
    }
    where V < MV
}

// Advance scan
node rule.advance_scan {
    match: node = {
        State: node = { scanPos: identifier = S };
        S: node = { next: identifier = N }
    }
    rewrite: node = {
        State: node = { scanPos: identifier = N }
    }
}

// Extract minimum - REMOVE it from original list
node rule.extract_min {
    match: node = {
        State: node = { minNode: identifier = M };
        Prev: node = { next: identifier = M };
        M: node = { value: number = MV; next: identifier = R }
    }
    rewrite: node = {
        Prev: node = { remove_next: identifier = M };  // EDGE DELETION!
        SortedHead: node = { next: identifier = M };
        M: node = { next: identifier = SortedHead.next };
        State: node = {}
    }
}

// Minimum at front - just move it
node rule.min_at_front {
    match: node = {
        State: node = { minNode: identifier = M };
        Head: node = { next: identifier = M };
        M: node = { value: number = MV; next: identifier = R }
    }
    rewrite: node = {
        Head: node = { next: identifier = R };
        SortedHead: node = { next: identifier = M };
        M: node = { next: identifier = SortedHead.next };
        State: node = {}
    }
}

// Setup next pass
node rule.next_pass {
    match: node = {
        State: node = { pass: number = P };
        Head: node = { next: identifier = Start }
    }
    rewrite: node = {
        State: node = {
            minVal: number = 999999;
            minNode: identifier = nil;
            scanPos: identifier = Start;
            pass: number = P + 1
        }
    }
    where P < 10
}

// Cleanup
node rule.cleanup {
    match: node = {
        State: node = { pass: number = 10 }
    }
    rewrite: node = {
        State: node = { delete: boolean = true }
    }
}