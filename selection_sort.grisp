//////////////////////////////////////////////////////////////
// demo: selection_sort.grisp
// algorithm: Selection Sort
// description: Repeatedly selects the smallest remaining element.
// version: 1.0
// author: Skybuck
//////////////////////////////////////////////////////////////

// --- List definition ---
node N1  { value: number = 9; next: identifier = N2 }
node N2  { value: number = 3; next: identifier = N3 }
node N3  { value: number = 7; next: identifier = N4 }
node N4  { value: number = 1; next: identifier = N5 }
node N5  { value: number = 8; next: identifier = N6 }
node N6  { value: number = 2; next: identifier = N7 }
node N7  { value: number = 5; next: identifier = N8 }
node N8  { value: number = 4; next: identifier = N9 }
node N9  { value: number = 6; next: identifier = N10 }
node N10 { value: number = 0 }

// --- Mark smallest element ---
node rule.mark_min {
    match: node = {
        A: node = { value: number = VA }
        B: node = { value: number = VB }
    }
    rewrite: node = {
        A: node = { value: number = VA }
        B: node = { value: number = VB; mark: number = 1 }
    }
}

// --- Move marked element left ---
node rule.move_marked_left {
    match: node = {
        P: node = {
            next: identifier = C
        }
        C: node = {
            mark: number = 1
        }
    }

    rewrite: node = {
        P: node = {
            next: identifier = C
            value: number = CV
        }
        C: node = {
            value: number = PV
            mark: number = 1
        }
    }
}
