{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GRISP v0.13 Rule Manifest Schema",
  "type": "object",
  "required": ["version", "generated_by", "policies", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v0\\.13$"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policies": {
      "type": "array",
      "items": { "$ref": "#/definitions/policy" }
    },
    "functions": {
      "type": "array",
      "items": { "$ref": "#/definitions/function" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/nodeType" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edgeType" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/definitions/rule" }
    },
    "retention": {
      "type": "object",
      "properties": {
        "default_tier": { "type": "string", "enum": ["audit", "compact", "prune"] },
        "tiers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "keep_days": { "type": "integer", "minimum": 0 }
            },
            "required": ["keep_days"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },

  "definitions": {
    "policy": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["string", "integer", "number", "boolean", "object", "array"] },
              "default": {}
            },
            "additionalProperties": false
          }
        },
        "body": {
          "type": "object",
          "description": "Policy fields (timeout_ms, on_timeout, retry, rate_limit, circuit_breaker, retention, etc.)",
          "additionalProperties": true
        },
        "description": { "type": "string" }
      }
    },

    "function": {
      "type": "object",
      "required": ["name", "signature"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "signature": { "type": "string" },
        "kind": { "type": "string", "enum": ["pure", "effect"] },
        "effect": {
          "type": "object",
          "properties": {
            "idempotent": { "type": "boolean" },
            "timeout_ms": { "type": "integer", "minimum": 0 },
            "on_timeout": { "type": "string", "enum": ["retry", "fail", "return_default", "propagate", "escalate"] }
          },
          "additionalProperties": false
        },
        "description": { "type": "string" }
      }
    },

    "nodeType": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "required": { "type": "boolean" },
              "default": {}
            },
            "additionalProperties": false
          }
        },
        "description": { "type": "string" }
      }
    },

    "edgeType": {
      "type": "object",
      "required": ["name", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "description": { "type": "string" }
      }
    },

    "rule": {
      "type": "object",
      "required": ["id", "name", "priority", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "priority": { "type": "integer" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/definitions/metadata" },
        "when": { "$ref": "#/definitions/whenBlock" },
        "then": { "$ref": "#/definitions/thenBlock" },
        "hooks": { "$ref": "#/definitions/hooks" }
      }
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idempotent": { "type": "boolean" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "use": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["policy"],
                "properties": {
                  "policy": { "type": "string" },
                  "params": { "type": "object", "additionalProperties": true }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "emits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reads": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "whenBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patterns": {
          "type": "array",
          "items": { "$ref": "#/definitions/pattern" }
        },
        "lets": {
          "type": "array",
          "items": { "$ref": "#/definitions/letBinding" }
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/definitions/condition" }
        }
      }
    },

    "pattern": {
      "type": "object",
      "required": ["var", "type"],
      "additionalProperties": false,
      "properties": {
        "var": { "type": "string" },
        "type": { "type": "string" },
        "where": { "type": "string" },
        "many": { "type": "boolean", "default": false },
        "edge": { "type": "string" }
      }
    },

    "letBinding": {
      "type": "object",
      "required": ["name", "expr"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "expr": { "type": "string" }
      }
    },

    "condition": {
      "type": "object",
      "required": ["expr"],
      "additionalProperties": false,
      "properties": {
        "expr": { "type": "string" }
      }
    },

    "thenBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },

    "action": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/definitions/letAction" },
        { "$ref": "#/definitions/updateAction" },
        { "$ref": "#/definitions/createAction" },
        { "$ref": "#/definitions/deleteAction" },
        { "$ref": "#/definitions/emitAction" },
        { "$ref": "#/definitions/forAction" },
        { "$ref": "#/definitions/callAction" }
      ]
    },

    "letAction": {
      "type": "object",
      "required": ["let", "expr"],
      "additionalProperties": false,
      "properties": {
        "let": { "type": "string" },
        "expr": { "type": "string" }
      }
    },

    "updateAction": {
      "type": "object",
      "required": ["update", "fields"],
      "additionalProperties": false,
      "properties": {
        "update": { "type": "string" },
        "fields": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },

    "createAction": {
      "type": "object",
      "required": ["create", "spec"],
      "additionalProperties": false,
      "properties": {
        "create": { "type": "string" },
        "spec": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },

    "deleteAction": {
      "type": "object",
      "required": ["delete"],
      "additionalProperties": false,
      "properties": {
        "delete": { "type": "string" },
        "when": { "type": "string" }
      }
    },

    "emitAction": {
      "type": "object",
      "required": ["emit"],
      "additionalProperties": false,
      "properties": {
        "emit": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "payload": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },

    "forAction": {
      "type": "object",
      "required": ["for", "in", "body"],
      "additionalProperties": false,
      "properties": {
        "for": { "type": "string" },
        "in": { "type": "string" },
        "body": {
          "type": "array",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },

    "callAction": {
      "type": "object",
      "required": ["call", "args"],
      "additionalProperties": false,
      "properties": {
        "call": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "result": { "type": "string" }
      }
    },

    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after_commit": {
          "type": "array",
          "items": { "type": "string" }
        },
        "on_failure": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },

  "examples": [
    {
      "version": "v0.13",
      "generated_by": "Skybuck",
      "generated_at": "2026-06-09T23:33:00Z",
      "policies": [
        {
          "name": "TimeoutRetry3x",
          "params": [],
          "body": {
            "timeout_ms": 5000,
            "on_timeout": "retry",
            "retry": { "backoff": "exponential", "max_attempts": 3, "initial_delay_ms": 100 }
          }
        }
      ],
      "rules": [
        {
          "id": "AssignPendingTask",
          "name": "AssignPendingTask",
          "priority": 80,
          "metadata": {
            "idempotent": false,
            "depends_on": ["ActivatePlannedTask"],
            "use": [
              { "policy": "TimeoutRetry3x" },
              { "policy": "RateLimitHigh", "params": { "max_per_tick": 200, "max_per_second": 1000 } }
            ],
            "emits": ["ASSIGN_TASK"]
          },
          "when": {
            "patterns": [
              { "var": "Task", "type": "Task", "where": "lifecycle == 'pending' and cost = Cost" },
              { "var": "Specialist", "type": "Agent", "where": "role == 'Specialist' and capacity_total - capacity_used >= Cost" }
            ],
            "lets": [],
            "conditions": [{ "expr": "CanExecute(Specialist, Task)" }]
          },
          "then": {
            "actions": [
              { "let": "NewCapacity", "expr": "Specialist.capacity_used + Cost" },
              { "update": "Task", "fields": { "lifecycle": "assigned", "updated_at": "Now()" } },
              { "update": "Specialist", "fields": { "capacity_used": "NewCapacity" } },
              { "create": "assigns", "spec": { "from": "Specialist", "to": "Task" } },
              { "emit": { "type": "ASSIGN_TASK", "payload": { "task": "Task.id", "agent": "Specialist.id" } } }
            ]
          },
          "hooks": { "after_commit": ["emit_assignment_webhook"] }
        }
      ]
    }
  ]
}
